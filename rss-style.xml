<?xml version="1.0" encoding="utf-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
  <xsl:template match="/">
    <html lang="en">
      <head>
        <title><xsl:value-of select="rss/channel/title"/> - RSS Feed</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/style.css" />
        <style>
          .rss-container {
              max-width: 800px;
              margin: 40px auto;
              padding: 20px;
              background: #1a1a1a;
              border: 1px solid #333;
              text-align: left;
          }
          .rss-header {
              border-bottom: 2px solid #FFA500;
              padding-bottom: 20px;
              margin-bottom: 30px;
          }
          .rss-feed-notice {
              background: #2b2b2b;
              border: 1px dashed #FFA500;
              padding: 15px;
              margin-bottom: 20px;
              font-family: monospace;
              font-size: 13px;
              color: #e1e1e1;
          }
          .rss-item {
              margin-bottom: 40px;
              padding-bottom: 20px;
              border-bottom: 1px solid #2b2b2b;
          }
          .rss-item h3 a {
              text-align: left;
              display: block;
              font-size: 20px;
          }
          .rss-meta {
              font-family: monospace;
              font-size: 12px;
              color: #888;
              margin: 5px 0 15px 0;
          }
          .rss-description {
              color: #ccc;
              line-height: 1.6;
          }
        </style>
      </head>
      <body>
        <div class="rss-container">
          <div class="rss-header">
            <h1 style="text-align:left; margin:0;"><xsl:value-of select="rss/channel/title"/></h1>
            <p style="text-align:left; color:#aaa; margin:5px 0 0 0;"><xsl:value-of select="rss/channel/description"/></p>
          </div>

          <div class="rss-feed-notice">
            <strong>This is an RSS Feed.</strong> Copy this page's URL into your favorite RSS Reader app to subscribe to updates automatically!
          </div>

          <div class="rss-items">
            <xsl:for-each select="rss/channel/item">
              <div class="rss-item">
                <h3>
                  <a href="{link}" class="yellow-link"><xsl:value-of select="title"/></a>
                </h3>
                <div class="rss-meta">
                  Published: <xsl:value-of select="pubDate"/>
                </div>
                <div class="rss-description">
                  <xsl:value-of select="description" disable-output-escaping="yes"/>
                </div>
              </div>
            </xsl:for-each>
          </div>
          
       <p><a href="/blog/blog" class="yellow-link">Return to main blog page.</a></p>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>